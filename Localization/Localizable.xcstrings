      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセス「{0}」は {1} を実行します。停止はプロセスグループ単位であり、コンテナは残り得ます。コンテナまで管理する場合は Docker Compose スタックとして登録してください。"
          }
        },
        "en": {
          "stringUnit": {
